// Tradepost's own tables (D-001). Provider-owned rows carry orgId (= providerId) and are read and
// written only through src/lib/tenancy.ts; tests/unit/tenancy-lint.test.ts fails on any other access.

model Listing {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  title       String
  category    ServiceCategory
  description String          @default("")
  // service area: a circle around (lat, lng), geocoded server-side from `address` on save; search
  // matches a client inside it (haversine). address is nullable only for rows written before D-020.
  address     String?
  lat         Float
  lng         Float
  radiusMiles Int
  rateCents   Int // base rate, integer cents
  days        Int[] // weekly availability: 0 = Sunday … 6 = Saturday
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  jobs        Job[]

  @@unique([id, orgId]) // target of Job's composite FK
  @@index([orgId])
  @@index([category])
}

enum ServiceCategory {
  plumbing
  electrical
  cleaning
  painting
  handyman
  landscaping
}

// P1 (F-20): a client's saved search. Kept out of tenancy.ts's MODELS list on purpose, like
// OrgContact below — every query is `userId`-scoped by the caller, never a foreign id. Matching
// (matchNewSavedSearches, cron) looks only at listings created after `checkedAt` and advances it
// each pass, so the same new listing is never notified twice.
model SavedSearch {
  id        String          @id @default(uuid()) @db.Uuid
  userId    String          @db.Uuid
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  ServiceCategory
  lat       Float
  lng       Float
  minRating Float           @default(0)
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  checkedAt DateTime        @default(now()) @db.Timestamptz(6)

  @@index([userId])
  @@index([category])
}

// A provider's SMS contact number (D-021), same shape as BillingAccount: one row per org, keyed and
// read/written by ctx.orgId only (never a foreign id), so it needs no tenancy.ts scoping.
model OrgContact {
  orgId String @id @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  phone String // E.164, e.g. +15125550100
}

// A provider's public rating. Written only by review publication (P0-3); read by search.
// Mean = sum / count, so there is no stored float to drift from the reviews.
model ProviderRating {
  orgId String @id @db.Uuid
  org   Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  count Int    @default(0)
  sum   Int    @default(0) // total stars
}

model Job {
  id        String   @id @default(uuid()) @db.Uuid
  orgId     String   @db.Uuid // the provider
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  clientId  String   @db.Uuid
  client    User     @relation(fields: [clientId], references: [id], onDelete: Restrict) // money rows never vanish with an account
  listingId String   @db.Uuid
  // (listingId, orgId): the database refuses a job whose listing belongs to another provider
  // NoAction: a listing with jobs cannot be deleted (money rows stay), but an org delete still cascades both
  listing   Listing  @relation(fields: [listingId, orgId], references: [id, orgId], onDelete: NoAction)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  date        DateTime  @db.Date // the day booked
  amountCents Int // the listing's rate when requested; held on accept (P0-3/4)
  status      JobStatus @default(requested) // moved only by transition() in src/lib/jobs.ts
  completedAt DateTime? @db.Timestamptz(6) // starts the 72h auto-confirm
  closedAt    DateTime? @db.Timestamptz(6) // starts the 14d review window
  ledger      LedgerEntry[]
  // Read only through src/lib (tests/unit/tenancy-lint.test.ts): reviews are blind and statements are admin-only.
  reviews     Review[]
  dispute     Dispute?
  messages    Message[]

  @@index([orgId])
  @@index([clientId])
  @@index([status, completedAt])
  // + partial unique (clientId, listingId, date) on live statuses: migration 20260926180000 (F-02)
}

enum JobStatus {
  requested
  accepted
  declined
  in_progress
  completed // by the provider; awaiting client confirmation or auto-confirm
  closed // confirmed by the client, auto-confirmed, or a dispute resolved; funds paid out
  disputed // P0-6: funds frozen until an admin resolves
  cancelled
}

// Escrow (P0-4). Append-only (a DB trigger). A job's `hold` row equals Job.amountCents, and once the
// job is settled its release + fee + refund rows sum to the same amount; tests/integration/jobs.test.ts
// checks that on every job. Restrict: a settled job cannot be deleted out from under its money.
model LedgerEntry {
  id          String     @id @default(uuid()) @db.Uuid
  jobId       String     @db.Uuid
  job         Job        @relation(fields: [jobId], references: [id], onDelete: Restrict)
  kind        LedgerKind
  amountCents Int // always > 0; the kind says which way it moved
  createdAt   DateTime   @default(now()) @db.Timestamptz(6)

  @@index([jobId])
}

enum LedgerKind {
  hold // client → escrow
  release // escrow → provider
  fee // escrow → platform
  refund // escrow → client
}

enum Party {
  client
  provider
}

// P0-5: blind mutual reviews. One per party per closed job, within 14 days of closedAt. Hidden from the
// other party until publishedAt is set: when both exist, or when the window ends (cron). Publishing the
// client's review adds its stars to ProviderRating, once (the publishedAt IS NULL guard).
model Review {
  id          String    @id @default(uuid()) @db.Uuid
  jobId       String    @db.Uuid
  job         Job       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  by          Party
  stars       Int // 1..5 (CHECK)
  body        String    @default("")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  publishedAt DateTime? @db.Timestamptz(6)

  @@unique([jobId, by])
  @@index([publishedAt])
}

// P0-6: one per job. Opened with the job's move to `disputed`; resolved with its move to `closed`.
// Statements are visible to platform admins only (D-005: text only, evidence upload is P1).
model Dispute {
  jobId             String    @id @db.Uuid
  job               Job       @relation(fields: [jobId], references: [id], onDelete: Restrict)
  openedBy          Party
  openedAt          DateTime  @default(now()) @db.Timestamptz(6)
  clientStatement   String?
  providerStatement String?
  resolvedAt        DateTime? @db.Timestamptz(6)
  resolvedBy        String?   @db.Uuid // the platform admin
  refundCents       Int? // the client's share; the rest is released less the fee
}

// Platform admins (D-005): resolve disputes across providers. Granted by inserting a row; no FK so a
// grant is a plain fact the template's User model does not need to know about.
model PlatformAdmin {
  userId    String   @id @db.Uuid
  grantedAt DateTime @default(now()) @db.Timestamptz(6)
}

// P0-7: the job's thread between client and provider. Written through the party's scoped job client
// (src/lib/threads.ts); a platform admin reads it only once the job has a dispute (open or resolved), and each read is
// audit-logged. Append-only (a DB trigger): a message can be dispute evidence.
model Message {
  id        String   @id @default(uuid()) @db.Uuid
  jobId     String   @db.Uuid
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Restrict)
  by        Party
  body      String
  createdAt DateTime @default(now()) @db.Timestamptz(6)

  @@index([jobId, createdAt])
}
